{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vk8s.aiotool.net/v0.2/project.json",
  "title": "vk8s Project",
  "description": "vk8s 프로젝트의 루트. 사이트, 노드, 클러스터, 워크로드를 모두 포함.",
  "type": "object",
  "required": ["version", "name", "mode", "sites", "clusters"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "enum": ["0.6"],
      "description": "스키마 버전. 마이그레이션 키. 이전 버전(0.1~0.4)은 자동 마이그레이션."
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": { "type": "string" },
    "mode": {
      "enum": ["onprem", "cloud", "hybrid"],
      "description": "프로젝트 모드. onprem이면 cloud Site 추가 불가, 그 반대도 동일. hybrid는 둘 다 허용."
    },
    "sites": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "site.json" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "node.json" },
      "description": "프로젝트의 모든 노드. site_id로 사이트와 연결."
    },
    "clusters": {
      "type": "array",
      "items": { "$ref": "cluster.json" }
    },
    "site_links": {
      "type": "array",
      "description": "사이트 간 연결 (VPN/Direct Connect/leased 등). 멀티 사이트 구성에서 트래픽 경로 표시.",
      "items": {
        "type": "object",
        "required": ["id", "from_site_id", "to_site_id", "kind"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string" },
          "from_site_id": { "type": "string" },
          "to_site_id": { "type": "string" },
          "kind": {
            "enum": ["vpn", "direct_connect", "internet", "leased", "private_link"],
            "description": "vpn=site-to-site VPN, direct_connect=AWS DX/Cloud Interconnect, internet=공용 인터넷, leased=전용회선, private_link=AWS PrivateLink/GCP PSC"
          },
          "bandwidth_gbps": { "type": "number" },
          "latency_ms": { "type": "number" },
          "encrypted": { "type": "boolean", "default": true },
          "notes": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "author": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "onprem" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "sites": {
            "type": "array",
            "items": { "properties": { "kind": { "const": "onprem" } } }
          }
        }
      }
    },
    {
      "if": { "properties": { "mode": { "const": "cloud" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "sites": {
            "type": "array",
            "items": { "properties": { "kind": { "const": "cloud" } } }
          }
        }
      }
    }
  ]
}
