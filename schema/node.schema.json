{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vk8s.aiotool.net/v0.2/node.json",
  "title": "Node",
  "description": "프로젝트에 배치된 단일 서버/인스턴스. 카탈로그에서 시드되거나 사용자 커스텀.",
  "type": "object",
  "required": ["id", "source", "brand", "model", "spec"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "프로젝트 내 고유 ID"
    },
    "name": { "type": "string" },
    "source": {
      "enum": ["onprem", "cloud"],
      "description": "배포 환경"
    },
    "brand": {
      "type": "string",
      "description": "AWS, NCP, Dell, HPE, Lenovo, Supermicro 등"
    },
    "model": {
      "type": "string",
      "description": "카탈로그 키 (예: p5.48xlarge, PowerEdge-XE9680). custom=true면 자유 입력."
    },
    "custom": {
      "type": "boolean",
      "default": false,
      "description": "true면 카탈로그 프리셋이 아닌 사용자 커스텀 스펙"
    },
    "site_id": {
      "type": "string",
      "description": "이 노드가 속한 Site의 id"
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "description": "설치 OS. VM/베어메탈 산출물(발주서·설치 목록)에 필요하고, k8s 노드에도 그대로 쓴다.",
      "properties": {
        "distro": { "type": "string", "description": "예: RHEL, Rocky, Ubuntu, Windows Server" },
        "version": { "type": "string", "description": "예: 8.8, 22.04, 2022" },
        "kernel": { "type": "string", "description": "예: 4.18.0-477.27.1.el8_8" }
      }
    },
    "purpose": {
      "enum": ["compute", "bastion", "storage", "edge", "management", "ci-runner"],
      "default": "compute",
      "description": "운영 목적. compute=일반 워크로드, bastion=SSH 점프 호스트, storage=SDS 전용 (Ceph 등), edge=엣지 노드, management=모니터링·운영 콘솔 등 관리 머신, ci-runner=빌드/배포 러너. management/bastion/ci-runner 노드는 architecture 뷰의 상단 'Ops/Mgmt' 레인에 별도로 그려짐."
    },
    "cluster_roles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["control-plane", "worker", "etcd"] },
      "default": [],
      "description": "이 노드가 클러스터에서 맡는 역할들. 빈 배열은 'unassigned'. control-plane+worker 겸용은 dev/단일노드 클러스터에서 일반적."
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "k8s 노드 라벨 (스케줄링 nodeSelector용)"
    },
    "taints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "effect"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string" },
          "value": { "type": "string" },
          "effect": { "enum": ["NoSchedule", "PreferNoSchedule", "NoExecute"] }
        }
      }
    },
    "spec": {
      "$ref": "node-spec.json"
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "description": "노드 네트워크 설정. ip는 cluster.network.node_subnet에서 자동 할당될 수 있음.",
      "properties": {
        "ip": {
          "type": "string",
          "description": "관리 IP (예: 192.168.10.11). 비어있으면 클러스터 할당 시 자동 부여."
        },
        "interfaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "ip": { "type": "string" },
              "vlan": { "type": "integer" },
              "purpose": { "enum": ["mgmt", "pod", "storage", "external"] },
              "speed_gbps": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
